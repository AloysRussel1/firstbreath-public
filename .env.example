# Clé de l'API Anthropic (console.anthropic.com) ; copier ce fichier en .env, jamais commiter .env
ANTHROPIC_API_KEY=
# Fournisseur utilisé par extraction/client.py : anthropic, ou simule pour tester sans appel ni coût
EXTRACTION_FOURNISSEUR=anthropic
# Modèle de vision utilisé par extraction/client.py
EXTRACTION_MODELE=claude-sonnet-5
# URL du backend FastAPI utilisée par le frontend (lue via import.meta.env.VITE_API_BASE_URL, défaut http://127.0.0.1:8000)
VITE_API_BASE_URL=http://localhost:8000
